src/**
tests/**
tsconfig.json
*.map
.gitignore

# Never package credentials. .gitignore keeps these out of git but says nothing
# about the VSIX, and vsce packages the extension folder wholesale, so without
# this a publishing token ships inside the extension.
.env
.env.*
*.pem
*.key

# Byte-compiling the hook locally leaves these behind, and stale bytecode of an
# older script is not something to ship.
**/__pycache__/**
*.pyc

assets/varterm-icons.svg
scripts/build-icon-font.mjs
scripts/preview-icon-font.html
scripts/publish-stores.sh
scripts/store-status.mjs
STORE_UPDATE.md
