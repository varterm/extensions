{
  "name": "varterm-cursor",
  "displayName": "Varterm TTS",
  "description": "Highlight text to hear it — no copy. Auto-read speaks agent replies. Change speed and preview voices from the status bar.",
  "version": "0.1.63",
  "publisher": "varterm",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0a0a0b",
    "theme": "dark"
  },
  "homepage": "https://varterm.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/varterm/extensions.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vartermCursor.connect",
        "title": "Varterm: Connect"
      },
      {
        "command": "vartermCursor.selectReadAloudVoice",
        "title": "Varterm: Select Read-Aloud Voice"
      },
      {
        "command": "vartermCursor.openPlaybackMenu",
        "title": "Varterm: Reading Speed and Voice"
      },
      {
        "command": "vartermCursor.setElevenLabsApiKey",
        "title": "Varterm: Set ElevenLabs API Key"
      },
      {
        "command": "vartermCursor.readEditorAloud",
        "title": "Varterm: Read Editor/Selection Aloud"
      },
      {
        "command": "vartermCursor.readClipboardAloud",
        "title": "Varterm: Read Clipboard Aloud",
        "icon": "$(clippy)"
      },
      {
        "command": "vartermCursor.readSelectionAloud",
        "title": "Varterm: Read Selection Aloud",
        "shortTitle": "Read selection",
        "icon": "$(selection)"
      },
      {
        "command": "vartermCursor.readSelectionOrClipboard",
        "title": "Varterm: Read Selection or Clipboard",
        "shortTitle": "Read aloud",
        "icon": "$(unmute)"
      },
      {
        "command": "vartermCursor.readErrorsAloud",
        "title": "Varterm: Read Errors & Warnings Aloud"
      },
      {
        "command": "vartermCursor.readLastAgentReply",
        "title": "Varterm: Read Last Agent Reply"
      },
      {
        "command": "vartermCursor.openKeyboardShortcuts",
        "title": "Varterm: Customize Keyboard Shortcuts"
      },
      {
        "command": "vartermCursor.openSettings",
        "title": "Varterm: Open Settings"
      },
      {
        "command": "vartermCursor.clearAudioCache",
        "title": "Varterm: Clear Audio Cache"
      },
      {
        "command": "vartermCursor.stopPlayback",
        "title": "Varterm: Stop Playback"
      },
      {
        "command": "vartermCursor.pausePlayback",
        "title": "Varterm: Pause Playback"
      },
      {
        "command": "vartermCursor.resumePlayback",
        "title": "Varterm: Resume Playback"
      },
      {
        "command": "vartermCursor.replayLast",
        "title": "Varterm: Replay Last Audio"
      },
      {
        "command": "vartermCursor.openListenQueue",
        "title": "Varterm: Listen Queue"
      },
      {
        "command": "vartermCursor.jumpBack",
        "title": "Varterm: Jump Back"
      },
      {
        "command": "vartermCursor.jumpForward",
        "title": "Varterm: Jump Forward"
      },
      {
        "command": "vartermCursor.statusBarAction",
        "title": "Varterm: Play, Pause, or Resume from Status Bar"
      },
      {
        "command": "vartermCursor.toggleAutoRead",
        "title": "Varterm: Toggle Auto-Read"
      },
      {
        "command": "vartermCursor.saveLastAudio",
        "title": "Varterm: Save Last Audio as MP3"
      },
      {
        "command": "vartermCursor.signInAccount",
        "title": "Varterm: Sign In to Account"
      },
      {
        "command": "vartermCursor.signOutAccount",
        "title": "Varterm: Sign Out of Account"
      },
      {
        "command": "vartermCursor.saveToLibrary",
        "title": "Varterm: Save Last Playback to Library"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vartermCursor.readSelectionOrClipboard",
          "group": "navigation@80"
        }
      ],
      "editor/context": [
        {
          "command": "vartermCursor.readSelectionAloud",
          "when": "editorHasSelection",
          "group": "varterm@1"
        },
        {
          "command": "vartermCursor.readClipboardAloud",
          "group": "varterm@2"
        },
        {
          "command": "vartermCursor.readErrorsAloud",
          "group": "varterm@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vartermCursor.readClipboardAloud",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+alt+l"
      },
      {
        "command": "vartermCursor.readEditorAloud",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+alt+r",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "varterm",
          "title": "Varterm",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "varterm": [
        {
          "type": "webview",
          "id": "varterm.player",
          "name": "Player"
        }
      ]
    },
    "configuration": {
      "title": "Varterm",
      "properties": {
        "vartermCursor.requestTimeoutMs": {
          "type": "number",
          "default": 90000,
          "minimum": 5000,
          "maximum": 180000,
          "description": "HTTP timeout per request in milliseconds. Increase for very long passages."
        },
        "vartermCursor.requestRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Retry count for transient API failures (429/5xx/timeouts)."
        },
        "vartermCursor.maxTotalTextChars": {
          "type": "number",
          "default": 1000000,
          "minimum": 10000,
          "maximum": 5000000,
          "description": "Maximum combined characters processed in a single operation."
        },
        "vartermCursor.chunkSize": {
          "type": "number",
          "default": 1800,
          "minimum": 400,
          "maximum": 5000,
          "description": "Chunk size used when processing large text."
        },
        "vartermCursor.chunkOverlap": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Chunk overlap used when processing large text."
        },
        "vartermCursor.askMaxChunks": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "description": "Advanced compatibility setting for context chunk retrieval."
        },
        "vartermCursor.askMaxContextChars": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 50000,
          "description": "Advanced compatibility setting for max context characters."
        },
        "vartermCursor.autoReadAnswersAloud": {
          "type": "boolean",
          "default": false,
          "description": "Automatically synthesize and play generated text responses."
        },
        "vartermCursor.autoReadAgentOutput": {
          "type": "boolean",
          "default": false,
          "description": "Last Auto-read choice, kept in sync with the status bar. Restart and updates read ~/.cursor/varterm-autoread.json, not this setting alone."
        },
        "vartermCursor.readAloudVoice": {
          "type": "string",
          "default": "en-US-AriaNeural",
          "description": "Voice ID used with /api/edge-tts for read-aloud playback."
        },
        "vartermCursor.readAloudRate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Playback speed for read-aloud synthesis."
        },
        "vartermCursor.readAloudProvider": {
          "type": "string",
          "default": "edge",
          "enum": [
            "edge",
            "premium"
          ],
          "description": "TTS provider for read aloud. Edge supports longer chunks, premium uses /api/tts voices."
        },
        "vartermCursor.elevenLabsApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional ElevenLabs API key override sent to /api/tts. Prefer using the command 'Varterm: Set ElevenLabs API Key' to store it securely."
        },
        "vartermCursor.maxCachedAudioFiles": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum leftover MP3s kept from older versions. Current playback stays in memory and does not write files."
        },
        "vartermCursor.maxCachedAudioAgeHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 2160,
          "description": "Delete cached MP3s older than this many hours. Set 0 to keep files until the count limit is reached."
        },
        "vartermCursor.showPlayingIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Show a small animated meter between Play and Auto-read while this window is playing audio."
        },
        "vartermCursor.resumeRewindMs": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "maximum": 5000,
          "description": "How far to rewind when resuming after a pause, in milliseconds. A small overlap makes sure no words are lost at the join."
        },
        "vartermCursor.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Send crash and failed-read reports to Sentry so we can fix issues. Never includes the text you listen to. Off if Cursor/VS Code telemetry is off."
        }
      }
    },
    "icons": {
      "varterm-bars-0": {
        "description": "Varterm waveform, playing frame 0",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E000"
        }
      },
      "varterm-bars-1": {
        "description": "Varterm waveform, playing frame 1",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E001"
        }
      },
      "varterm-bars-2": {
        "description": "Varterm waveform, playing frame 2",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E002"
        }
      },
      "varterm-bars-3": {
        "description": "Varterm waveform, playing frame 3",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E003"
        }
      },
      "varterm-bars-4": {
        "description": "Varterm waveform, playing frame 4",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E004"
        }
      },
      "varterm-bars-5": {
        "description": "Varterm waveform, playing frame 5",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E005"
        }
      },
      "varterm-bars-6": {
        "description": "Varterm waveform, playing frame 6",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E006"
        }
      },
      "varterm-bars-7": {
        "description": "Varterm waveform, playing frame 7",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E007"
        }
      },
      "varterm-bars-idle": {
        "description": "Varterm waveform, paused",
        "default": {
          "fontPath": "assets/varterm-icons.ttf",
          "fontCharacter": "\\E008"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-icon-font.mjs && tsc -p .",
    "icons": "node scripts/build-icon-font.mjs",
    "watch": "tsc -watch -p .",
    "check": "tsc --noEmit -p .",
    "package": "npm run build && npx @vscode/vsce package --follow-symlinks",
    "publish:stores": "bash scripts/publish-stores.sh",
    "publish:ovsx": "bash scripts/publish-stores.sh --only-ovsx",
    "publish:dry-run": "bash scripts/publish-stores.sh --dry-run",
    "publish:dry-run:ovsx": "bash scripts/publish-stores.sh --only-ovsx --dry-run",
    "stores:status": "node scripts/store-status.mjs"
  },
  "keywords": [
    "speech-synthesis",
    "voice-reader",
    "accessibility",
    "vscode",
    "cursor",
    "tts",
    "text-to-speech",
    "read-aloud",
    "auto-read",
    "agent",
    "audio"
  ],
  "author": "Varterm",
  "dependencies": {
    "@varterm/tts-client": "file:../../packages/tts-client"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.9.1",
    "svg2ttf": "^6.1.0",
    "typescript": "^6.0.3"
  }
}
